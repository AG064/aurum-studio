# Use LF for text on commit and checkout, except Windows launch scripts below.
* text=auto eol=lf

# Rust files should always be LF
*.rs text eol=lf
*.toml text eol=lf

# GDScript / scenes
*.gd text eol=lf
*.tscn text eol=lf
*.gdshader text eol=lf

# Documentation
*.md text eol=lf

# PowerShell / shell scripts
*.ps1 text eol=lf
*.sh text eol=lf

# Windows-only scripts that need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Reviewable configuration and vector assets
Cargo.lock text eol=lf
*.godot text eol=lf
*.svg text eol=lf

# Binary files (no line-ending conversion)
*.dll binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.glb binary
*.wav binary
*.ttf binary
*.zip binary
